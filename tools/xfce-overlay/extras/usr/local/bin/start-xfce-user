#!/bin/sh
# Installed system: start X and an XFCE session for user $1 (supervised by systemL).
U=$1
[ -n "$U" ] || { echo "usage: start-xfce-user USER" >&2; exit 1; }
UID_=$(id -u "$U") || exit 1
HOME_=$(getent passwd "$U" | cut -d: -f6)
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUNDIR=/run/user/$UID_
mkdir -p "$RUNDIR" && chown "$U" "$RUNDIR" && chmod 0700 "$RUNDIR"
mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
AUTH=$RUNDIR/Xauthority
rm -f "$AUTH"
xauth -f "$AUTH" add :0 . "$(mcookie)"
chown "$U" "$AUTH"
# wait (up to 10s) for udev to expose the GPU
i=0
while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 50 ]; do sleep 0.2; i=$((i+1)); done
exec xinit /usr/bin/runuser -u "$U" -- env HOME="$HOME_" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8 \
    XDG_RUNTIME_DIR="$RUNDIR" XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE \
    XDG_DATA_DIRS=/usr/local/share:/usr/share XDG_CONFIG_DIRS=/etc/xdg XAUTHORITY="$AUTH" \
    dbus-run-session -- startxfce4 -- /usr/lib/xorg/Xorg :0 vt7 -nolisten tcp -noreset -auth "$AUTH"
