#!/bin/bash
# systemLinux graphical installer (yad dialogs). Asks a few questions, then runs
# systemlinux-install-run, which partitions the chosen disk, copies the live system and installs GRUB.
ICON=/usr/share/systemlinux/logo.png
TITLE="Install systemLinux"
Y() { yad --center --window-icon="$ICON" --title="$TITLE" "$@"; }

Y --image="$ICON" --image-on-top --width=520 --button="Cancel:1" --button="Next:0" \
  --text="<big><b>Install systemLinux</b></big>\n\nThis wizard erases <b>one disk</b> and installs systemLinux on it.\nIt takes a few minutes. Save your work first." || exit 0

# ---- choose the disk (skip disks with mounted partitions, such as the stick you booted from)
rows=()
for d in /sys/block/*; do
    n=$(basename "$d")
    case "$n" in loop*|ram*|sr*|zram*|fd*|dm-*|md*|nbd*) continue ;; esac
    sectors=$(cat "$d/size" 2>/dev/null); [ "${sectors:-0}" -gt 0 ] || continue
    grep -q "^/dev/$n" /proc/self/mounts && continue
    gb=$(( sectors * 512 / 1000000000 ))
    model=$(tr -s ' ' < "$d/device/model" 2>/dev/null | sed 's/ *$//')
    rows+=("/dev/$n" "${gb} GB" "${model:-disk}")
done
if [ "${#rows[@]}" -eq 0 ]; then
    Y --image=dialog-error --button="Close:0" --text="No installable disk was found.\n(Disks with mounted partitions are not offered.)"
    exit 1
fi
DISK=$(Y --list --width=600 --height=340 --separator= --print-column=1 \
    --column=Disk --column=Size --column=Model "${rows[@]}" \
    --text="Choose the disk to <b>ERASE</b> and install onto:" --button="Cancel:1" --button="Next:0") || exit 0
[ -n "$DISK" ] || exit 0

# ---- account and system settings
TZLIST="UTC!$(cd /usr/share/zoneinfo && find Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific -type f 2>/dev/null | sort | paste -sd'!')"
KEYS="us!uk!de!fr!es!it!pt-latin1!br-abnt2!ru!dvorak!colemak"
HOST=systemlinux USERN= TZ=UTC KEYMAP=us
while :; do
    out=$(Y --form --width=520 --separator='|' --button="Cancel:1" --button="Install:0" \
        --text="Set up your system:" \
        --field="Computer name" "$HOST" \
        --field="Your username" "$USERN" \
        --field="Your password:H" "" \
        --field="Repeat your password:H" "" \
        --field="Root password (empty = same as yours):H" "" \
        --field="Time zone:CBE" "$TZ!$TZLIST" \
        --field="Keyboard layout:CBE" "$KEYMAP!$KEYS") || exit 0
    IFS='|' read -r HOST USERN PW1 PW2 RPW TZ KEYMAP _ <<< "$out"
    err=
    [[ "$HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || err="The computer name may only use letters, digits and '-'."
    [[ "$USERN" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$USERN" != root ]] || err="The username must be lowercase letters, digits, '_' or '-', and not 'root'."
    [ -n "$PW1" ] || err="Choose a password."
    [ "$PW1" = "$PW2" ] || err="The two passwords do not match."
    [ -f "/usr/share/zoneinfo/$TZ" ] || err="Unknown time zone: $TZ"
    [[ "$KEYMAP" =~ ^[A-Za-z0-9._-]+$ ]] || err="Invalid keyboard layout name."
    [ -z "$err" ] && break
    Y --image=dialog-error --button="Back:0" --text="$err"
done
[ -n "$RPW" ] || RPW=$PW1

Y --image=dialog-warning --width=520 --button="Cancel:1" --button="Erase and install:0" \
  --text="<b>All data on $DISK will be destroyed.</b>\n\nComputer name: $HOST\nUser: $USERN\nTime zone: $TZ    Keyboard: $KEYMAP\n\nContinue?" || exit 0

# ---- install
LOG=/tmp/systemlinux-install.log
: > "$LOG"
printf '%s\n%s\n' "$RPW" "$PW1" | /usr/local/bin/systemlinux-install-run "$DISK" "$HOST" "$USERN" "$TZ" "$KEYMAP" 2>>"$LOG" \
    | Y --progress --pulsate --auto-close --no-buttons --width=560 --text="Starting..."
rc=${PIPESTATUS[1]}

if [ "$rc" -ne 0 ]; then
    tail -n 40 "$LOG" | Y --text-info --width=760 --height=420 --button="Close:0" --title="Installation failed"
    exit 1
fi
if Y --image="$ICON" --width=480 --button="Stay here:1" --button="Restart now:0" \
    --text="<big><b>systemLinux is installed.</b></big>\n\nRemove the installation stick, then restart."; then
    reboot
fi
