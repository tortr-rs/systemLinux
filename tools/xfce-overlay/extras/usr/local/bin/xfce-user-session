#!/bin/sh
# X client started by start-xfce-user: run an XFCE session as user $1 on a private D-Bus session.
# usage: xfce-user-session USER HOME RUNTIME_DIR XAUTHORITY
exec runuser -u "$1" -- env HOME="$2" USER="$1" LOGNAME="$1" SHELL=/bin/bash LANG=C.UTF-8 \
    XDG_RUNTIME_DIR="$3" XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE \
    XDG_DATA_DIRS=/usr/local/share:/usr/share XDG_CONFIG_DIRS=/etc/xdg XAUTHORITY="$4" \
    dbus-run-session -- startxfce4
