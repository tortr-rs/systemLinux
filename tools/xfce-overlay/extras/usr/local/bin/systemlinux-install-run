#!/bin/bash
# systemLinux install backend.
# usage: systemlinux-install-run DISK HOSTNAME USERNAME TIMEZONE KEYMAP
# stdin: two lines, the root password and then the user's password.
# Prints "# message" progress lines on stdout; the log goes to stderr.
set -euo pipefail
DISK=$1 HOST=$2 USERN=$3 TZ=$4 KEYMAP=$5
read -r ROOTPW
read -r USERPW
ROOT=/mnt/target

step() { echo "# $*"; echo "== $*" >&2; }
fail() { echo "ERROR: $*" >&2; exit 1; }
cleanup() { sync; umount -R "$ROOT" 2>/dev/null || true; }
trap cleanup EXIT
part() { case "$DISK" in *[0-9]) echo "${DISK}p$1" ;; *) echo "${DISK}$1" ;; esac; }
wait_for() { for _ in $(seq 1 50); do [ -b "$1" ] && return 0; sleep 0.2; done; fail "partition $1 did not appear"; }

[ -b "$DISK" ] || fail "$DISK is not a block device"
if grep -q "^$DISK" /proc/self/mounts; then fail "$DISK has mounted partitions"; fi
EFI=0; [ -d /sys/firmware/efi ] && EFI=1

step "Erasing $DISK"
wipefs -a -f "$DISK" >/dev/null 2>&1 || true
dd if=/dev/zero of="$DISK" bs=1M count=4 status=none
SZ=$(blockdev --getsz "$DISK")
[ "$SZ" -gt 16384 ] && dd if=/dev/zero of="$DISK" bs=512 seek=$((SZ - 8192)) count=8192 status=none 2>/dev/null || true

step "Creating partitions"
if [ "$EFI" = 1 ]; then
    printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --wipe always --wipe-partitions always "$DISK" >&2
    ESPDEV=$(part 1); ROOTDEV=$(part 2)
else
    printf 'label: dos\n,,L,*\n' | sfdisk --wipe always --wipe-partitions always "$DISK" >&2
    ESPDEV=; ROOTDEV=$(part 1)
fi
blockdev --rereadpt "$DISK" >&2 || true
udevadm settle --timeout=10 >&2 || true
[ -z "$ESPDEV" ] || wait_for "$ESPDEV"
wait_for "$ROOTDEV"

step "Formatting"
[ -z "$ESPDEV" ] || mkfs.vfat -F32 -n EFI "$ESPDEV" >&2
mkfs.ext4 -F -q -L systemLinux "$ROOTDEV" >&2

step "Mounting"
mkdir -p "$ROOT"
mount "$ROOTDEV" "$ROOT"
if [ -n "$ESPDEV" ]; then mkdir -p "$ROOT/boot/efi"; mount "$ESPDEV" "$ROOT/boot/efi"; fi

step "Copying system files (this takes a few minutes)"
/usr/local/bin/systemlinux-copy "$ROOT" >&2

step "Writing fstab"
RUUID=$(blkid -s UUID -o value "$ROOTDEV")
{
    echo "# /etc/fstab - generated by the systemLinux installer"
    echo "UUID=$RUUID  /  ext4  defaults,errors=remount-ro  0  1"
    if [ -n "$ESPDEV" ]; then echo "UUID=$(blkid -s UUID -o value "$ESPDEV")  /boot/efi  vfat  umask=0077  0  2"; fi
} > "$ROOT/etc/fstab"

step "Setting the computer name, time zone and keyboard"
echo "$HOST" > "$ROOT/etc/hostname"
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$HOST" > "$ROOT/etc/hosts"
rm -f "$ROOT/etc/localtime"; ln -s "../usr/share/zoneinfo/$TZ" "$ROOT/etc/localtime"
echo "LANG=C.UTF-8" > "$ROOT/etc/locale.conf"
echo "KEYMAP=$KEYMAP" > "$ROOT/etc/vconsole.conf"
LAYOUT=$KEYMAP VARIANT=
case "$KEYMAP" in
    uk) LAYOUT=gb ;;
    dvorak) LAYOUT=us VARIANT=dvorak ;;
    colemak) LAYOUT=us VARIANT=colemak ;;
    pt-latin1) LAYOUT=pt ;;
    br-abnt2) LAYOUT=br ;;
    *-latin1|*-latin9) LAYOUT=${KEYMAP%%-*} ;;
esac
mkdir -p "$ROOT/etc/X11/xorg.conf.d"
{
    echo 'Section "InputClass"'
    echo '    Identifier "system-keyboard"'
    echo '    MatchIsKeyboard "on"'
    echo "    Option \"XkbLayout\" \"$LAYOUT\""
    [ -z "$VARIANT" ] || echo "    Option \"XkbVariant\" \"$VARIANT\""
    echo 'EndSection'
} > "$ROOT/etc/X11/xorg.conf.d/00-keyboard.conf"

step "Creating your account"
printf '%s\n%s\n' "$USERPW" "$USERPW" | goget provision --user "$USERN" "$ROOT" >&2
echo "root:$ROOTPW" | chpasswd -R "$ROOT" >&2
groups=
for g in users audio video input; do grep -q "^$g:" "$ROOT/etc/group" && groups="$groups,$g"; done
[ -z "$groups" ] || usermod -R "$ROOT" -aG "${groups#,}" "$USERN" >&2

step "Finishing the installed system"
/usr/local/bin/systemlinux-post "$ROOT" >&2

step "Installing the bootloader"
/usr/local/bin/systemlinux-bootloader "$ROOT" >&2

step "Done"
