#!/bin/sh
# Calamares job: finish the installed system at $1 (branding, login, desktop autostart, identity).
set -e
ROOT=$1
[ -d "$ROOT/etc" ] || { echo "target root $ROOT not found" >&2; exit 1; }

# the first regular user created by the installer
USERNAME=$(awk -F: '$3>=1000 && $3<60000 {print $1; exit}' "$ROOT/etc/passwd")

# issue, os-release, release files and the login banner
goget provision "$ROOT"

# tty1 asks for a login instead of opening a root shell
mkdir -p "$ROOT/etc/systemL"
: > "$ROOT/etc/systemL/login"

# start XFCE for that user at boot (no display manager: systemL starts X and the session)
if [ -n "$USERNAME" ]; then
    printf '# started and supervised by systemL: <name> <command> [args...]\nxfce /usr/local/bin/start-xfce-user %s\n' \
        "$USERNAME" > "$ROOT/etc/systemL/services.conf"
fi

# every install gets its own machine identity
rm -f "$ROOT/etc/machine-id" "$ROOT/var/lib/dbus/machine-id"
rm -f "$ROOT"/etc/ssh/ssh_host_*
