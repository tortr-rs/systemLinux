#!/bin/bash
# Calamares job: install GRUB for the system at $1 (same layout as the handbook).
set -euo pipefail
ROOT=$1
ROOTDEV=$(findmnt -n -o SOURCE --target "$ROOT")
PARTUUID=$(blkid -s PARTUUID -o value "$ROOTDEV")
[ -n "$PARTUUID" ] || { echo "cannot find the PARTUUID of $ROOTDEV" >&2; exit 1; }

mkdir -p "$ROOT/boot/grub"
[ -f "$ROOT/boot/vmlinuz" ] || cp /boot/vmlinuz "$ROOT/boot/vmlinuz"
cat > "$ROOT/boot/grub/grub.cfg" <<GRUBCFG
set default=0
set timeout=3

menuentry "systemLinux v0.4" {
    linux /boot/vmlinuz root=PARTUUID=$PARTUUID rootwait rw console=tty0 init=/sbin/systemL quiet loglevel=3
}
GRUBCFG

if [ -d /sys/firmware/efi ]; then
    grub-install --target=x86_64-efi --efi-directory="$ROOT/boot/efi" \
        --boot-directory="$ROOT/boot" --removable
    # also register a boot entry in the firmware (the removable path above is the fallback)
    if mountpoint -q "$ROOT/boot/efi"; then
        ESPDEV=$(findmnt -n -o SOURCE --target "$ROOT/boot/efi")
        DISK=/dev/$(lsblk -no PKNAME "$ESPDEV")
        PARTNUM=$(cat "/sys/class/block/$(basename "$ESPDEV")/partition")
        efibootmgr -c -d "$DISK" -p "$PARTNUM" -L systemLinux -l '\EFI\BOOT\BOOTX64.EFI' || true
    fi
else
    DISK=/dev/$(lsblk -no PKNAME "$ROOTDEV")
    grub-install --target=i386-pc --boot-directory="$ROOT/boot" "$DISK"
fi
