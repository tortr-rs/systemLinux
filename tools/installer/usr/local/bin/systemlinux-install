#!/bin/bash
# systemLinux installer: the Handbook's installation, asked as questions. Run it from the live system as root.
#
#   1. partition (whole disk) or format (one partition you freed up for dual-boot)
#   2. optionally encrypt the root partition with LUKS
#   3. download the stage tarball for this release (or use --stage FILE) and check its SHA-256
#   4. extract it onto the new root filesystem
#   5. fstab, hostname, timezone, keymap, your account and root's password
#   6. GRUB (UEFI and/or legacy BIOS) and its menu (systemlinux-grubcfg)
#
# Whole disk: GPT with a 1 MiB BIOS boot partition, a 1 GiB EFI System Partition mounted at /boot (GRUB and the
# kernels live there, so an encrypted root needs nothing special from GRUB) and the root partition (ext4).
# Partition (dual-boot): that partition becomes the root filesystem (ext4); on UEFI the existing EFI System
# Partition is mounted at /boot/efi and only GRUB's EFI program goes there, the kernels stay in /boot.
#
# usage: systemlinux-install (--disk DISK | --partition PART [--esp ESPPART]) [--stage FILE]
#                             [--host HOST] [--user USER] [--tz TZ] [--keymap KEYMAP] [--luks] [--yes]
set -euo pipefail
REPO=tortr-rs/systemLinux
DISK= PART= ESP= HOST= USERN= TZ= KEYMAP= LUKS=0 ASSUMEYES=0 STAGE=
while [ $# -gt 0 ]; do
    case "$1" in
        --disk) DISK=$2; shift 2 ;;
        --partition) PART=$2; shift 2 ;;
        --esp) ESP=$2; shift 2 ;;
        --stage) STAGE=$2; shift 2 ;;
        --host) HOST=$2; shift 2 ;;
        --user) USERN=$2; shift 2 ;;
        --tz) TZ=$2; shift 2 ;;
        --keymap) KEYMAP=$2; shift 2 ;;
        --luks) LUKS=1; shift ;;
        --yes) ASSUMEYES=1; shift ;;
        -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
        *) echo "systemlinux-install: unknown option $1" >&2; exit 2 ;;
    esac
done
die() { echo "systemlinux-install: $*" >&2; exit 1; }
say() { echo "== $*"; }
[ "$(id -u)" = 0 ] || die "must run as root"
if [ -d /sys/firmware/efi ]; then FW=uefi; else FW=bios; fi
VER=$(cat /usr/share/systemlinux/image-version 2>/dev/null || true)
[ -n "$VER" ] || die "this system has no version (/usr/share/systemlinux/image-version)"
STAGE_NAME=systemLinux-stage-$VER-x86_64.tar.xz
STAGE_URL=https://github.com/$REPO/releases/download/v$VER/$STAGE_NAME

ask() { # ask PROMPT VARNAME [DEFAULT]
    local reply
    if [ -n "${3:-}" ]; then read -r -p "$1 [$3] " reply; reply=${reply:-$3}; else read -r -p "$1 " reply; fi
    printf -v "$2" '%s' "$reply"
}
ask_secret() { local reply; read -r -s -p "$1 " reply; echo; printf -v "$2" '%s' "$reply"; }

# ---- the stage: a local file, or this release's download (checked now, before any disk is touched) -------------
if [ -n "$STAGE" ]; then
    [ -f "$STAGE" ] || die "$STAGE: no such file"
else
    curl -fsIL --max-time 20 "$STAGE_URL" >/dev/null ||
        die "cannot reach $STAGE_URL
  Connect to the network first (nmcli device wifi connect NAME password PASS), or download the stage on another
  computer and pass it with --stage FILE."
fi

# ---- where to install ----------------------------------------------------------------------------------------
if [ -z "$DISK" ] && [ -z "$PART" ]; then
    echo "Disks:"; lsblk -d -e 7,11 -o NAME,SIZE,MODEL -n | sed 's/^/  \/dev\//'
    echo
    echo "Install onto a whole disk (erases it), or onto one partition you already freed up for dual-boot"
    echo "(made with GParted, cfdisk or Windows Disk Management beforehand)?"
    ask "  [d]isk or [p]artition?" MODE d
    case "$MODE" in
        p|P) lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS; ask "Partition to install onto (e.g. /dev/sda3):" PART ;;
        *)   ask "Disk to erase (e.g. /dev/sda):" DISK ;;
    esac
fi
[ -n "$DISK" ] && [ -n "$PART" ] && die "--disk and --partition are mutually exclusive"
[ -n "$DISK" ] || [ -n "$PART" ] || die "nothing to install onto"
if [ -n "$DISK" ]; then
    [ -b "$DISK" ] || die "$DISK is not a block device"
    grep -q "^$DISK" /proc/self/mounts && die "$DISK has mounted partitions (umount them first)"
else
    [ -b "$PART" ] || die "$PART is not a block device"
    grep -q "^$PART " /proc/self/mounts && die "$PART is mounted (umount it first)"
    if [ "$FW" = uefi ] && [ -z "$ESP" ]; then
        mapfile -t esps < <(lsblk -rno NAME,PARTTYPE | awk '$2=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {print "/dev/"$1}')
        case "${#esps[@]}" in
            1) ESP=${esps[0]}; echo "Using the existing EFI System Partition: $ESP" ;;
            0) die "no EFI System Partition found; pass --esp to name one" ;;
            *) echo "Found more than one EFI System Partition:"; printf '  %s\n' "${esps[@]}"
               ask "Which one should systemLinux use?" ESP ;;
        esac
        [ -b "$ESP" ] || die "$ESP is not a block device"
    fi
fi

# ---- the system's settings -----------------------------------------------------------------------------------
[ -n "$HOST" ] || ask "Computer name:" HOST systemlinux
[[ "$HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || die "invalid computer name"
[ -n "$USERN" ] || ask "Your username:" USERN
[[ "$USERN" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username (lowercase letters, digits, - and _)"
[ -n "$TZ" ] || ask "Timezone (e.g. Europe/Paris, America/New_York):" TZ UTC
[ -f "/usr/share/zoneinfo/$TZ" ] || { echo "Unknown timezone $TZ, using UTC" >&2; TZ=UTC; }
[ -n "$KEYMAP" ] || ask "Console keymap (e.g. us, uk, de, fr):" KEYMAP us
while :; do
    ask_secret "Password for $USERN:" USERPW; ask_secret "Again:" USERPW2
    [ "$USERPW" = "$USERPW2" ] && [ -n "$USERPW" ] && break
    echo "The passwords did not match (or were empty), try again." >&2
done
ROOTPW=$USERPW
ask "Use the same password for root? [Y/n]" SAMEPW Y
if [[ ! "$SAMEPW" =~ ^[Yy]?$ ]]; then
    while :; do
        ask_secret "Root password:" ROOTPW; ask_secret "Again:" ROOTPW2
        [ "$ROOTPW" = "$ROOTPW2" ] && [ -n "$ROOTPW" ] && break
        echo "The passwords did not match (or were empty), try again." >&2
    done
fi
if [ -n "$PART" ] && [ "$LUKS" = 1 ]; then
    die "--luks needs a whole-disk install (the kernels must sit outside the encrypted partition); see the Handbook's disk chapter to do it by hand"
fi
if [ -n "$DISK" ] && [ "$LUKS" = 0 ] && [ "$ASSUMEYES" = 0 ]; then
    ask "Encrypt the root partition with LUKS? [y/N]" ENC N
    [[ "$ENC" =~ ^[Yy]$ ]] && LUKS=1
fi
LUKSPW=
if [ "$LUKS" = 1 ]; then
    while :; do
        ask_secret "Encryption passphrase (asked at every boot):" LUKSPW; ask_secret "Again:" LUKSPW2
        [ "$LUKSPW" = "$LUKSPW2" ] && [ -n "$LUKSPW" ] && break
        echo "The passphrases did not match (or were empty), try again." >&2
    done
fi
if [ "$ASSUMEYES" = 0 ]; then
    echo
    if [ -n "$DISK" ]; then echo "This ERASES EVERYTHING on $DISK ($(lsblk -dno SIZE,MODEL "$DISK"))."
    else echo "This formats $PART; the rest of the disk${ESP:+ and $ESP} stay as they are."; fi
    ask "Type 'yes' to continue:" CONFIRM
    [ "$CONFIRM" = yes ] || { echo "Aborted."; exit 1; }
fi

# ---- 1. partitions and filesystems ---------------------------------------------------------------------------
M=/mnt
cleanup() {
    sync
    umount -R "$M" 2>/dev/null || true
    [ "$LUKS" = 1 ] && cryptsetup close root 2>/dev/null || true
}
trap cleanup EXIT
part() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "${1}$2" ;; esac; }
wait_for() { for _ in $(seq 1 50); do [ -b "$1" ] && return 0; sleep 0.2; done; die "partition $1 did not appear"; }

BOOTDEV= EFIDEV=
if [ -n "$DISK" ]; then
    say "partitioning $DISK"
    wipefs -a -f "$DISK" >/dev/null 2>&1 || true
    #   1: BIOS boot (1 MiB, GRUB's core image on legacy BIOS)  2: EFI System Partition, mounted at /boot  3: root
    printf 'label: gpt\n,1M,21686148-6449-6E6F-744E-656564454649\n,1G,U\n,,L\n' | sfdisk -q --wipe always --wipe-partitions always "$DISK"
    blockdev --rereadpt "$DISK" 2>/dev/null || true
    udevadm settle --timeout=10 || true
    BOOTDEV=$(part "$DISK" 2); ROOTPART=$(part "$DISK" 3)
    wait_for "$BOOTDEV"; wait_for "$ROOTPART"
    mkfs.vfat -F32 -n BOOT "$BOOTDEV" >/dev/null
else
    ROOTPART=$PART EFIDEV=$ESP
fi
if [ "$LUKS" = 1 ]; then
    say "encrypting $ROOTPART"
    printf '%s' "$LUKSPW" | cryptsetup luksFormat --batch-mode --type luks2 "$ROOTPART" -
    printf '%s' "$LUKSPW" | cryptsetup open "$ROOTPART" root -
    ROOTDEV=/dev/mapper/root
else
    ROOTDEV=$ROOTPART
fi
say "formatting the root filesystem (ext4)"
mkfs.ext4 -F -q -L systemLinux "$ROOTDEV"
mkdir -p "$M"
mount "$ROOTDEV" "$M"

# ---- 2. the stage --------------------------------------------------------------------------------------------
if [ -z "$STAGE" ]; then
    say "downloading the systemLinux $VER stage"
    curl -fL --progress-bar -o "$M/$STAGE_NAME" "$STAGE_URL"
    curl -fsSL -o "$M/$STAGE_NAME.sha256" "$STAGE_URL.sha256"
    (cd "$M" && sha256sum -c "$STAGE_NAME.sha256" >/dev/null) || die "the stage's checksum does not match: the download is damaged, run the installer again"
    STAGE=$M/$STAGE_NAME
fi
say "extracting the stage (a few minutes)"
tar --numeric-owner --xattrs --xattrs-include='*' --acls -xpJf "$STAGE" -C "$M"
rm -f "$M/$STAGE_NAME" "$M/$STAGE_NAME.sha256"

# the stage's kernel and initramfs go to /boot/systemlinux, on the boot partition when there is one
mkdir -p "$M/var/tmp/kernel"
mv "$M/boot/vmlinuz" "$M/boot/initrd.img" "$M/var/tmp/kernel/"
if [ -n "$BOOTDEV" ]; then mount "$BOOTDEV" "$M/boot"; fi
if [ -n "$EFIDEV" ]; then mkdir -p "$M/boot/efi"; mount "$EFIDEV" "$M/boot/efi"; fi
mkdir -p "$M/boot/systemlinux"
mv "$M/var/tmp/kernel/vmlinuz" "$M/var/tmp/kernel/initrd.img" "$M/boot/systemlinux/"
rmdir "$M/var/tmp/kernel"

# ---- 3. configuration ----------------------------------------------------------------------------------------
say "writing the configuration"
uuid() { blkid -s UUID -o value "$1"; }
{
    echo "# /etc/fstab: <filesystem> <mount point> <type> <options> <dump> <pass>"
    if [ "$LUKS" = 1 ]; then echo "/dev/mapper/root  /  ext4  defaults,noatime  0 1"
    else echo "UUID=$(uuid "$ROOTDEV")  /  ext4  defaults,noatime  0 1"; fi
    [ -z "$BOOTDEV" ] || echo "UUID=$(uuid "$BOOTDEV")  /boot  vfat  umask=0077  0 2"
    [ -z "$EFIDEV" ] || echo "UUID=$(uuid "$EFIDEV")  /boot/efi  vfat  umask=0077  0 2"
} > "$M/etc/fstab"
echo "$HOST" > "$M/etc/hostname"
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$HOST" > "$M/etc/hosts"
ln -sf "../usr/share/zoneinfo/$TZ" "$M/etc/localtime"
echo "LANG=C.UTF-8" > "$M/etc/locale.conf"
echo "KEYMAP=$KEYMAP" > "$M/etc/vconsole.conf"
say "creating your account"
printf '%s\n%s\n' "$USERPW" "$USERPW" | systemlinux-provision --user "$USERN" "$M"
echo "root:$ROOTPW" | chpasswd -R "$M"

# ---- 4. the bootloader ---------------------------------------------------------------------------------------
say "installing GRUB"
GB=$M/boot/systemlinux
if [ -n "$DISK" ]; then
    # both firmwares, so the disk boots anywhere
    grub-install --target=i386-pc --boot-directory="$GB" "$DISK"
    NVRAM=--no-nvram; [ -d /sys/firmware/efi/efivars ] && NVRAM=
    grub-install --target=x86_64-efi --efi-directory="$M/boot" --boot-directory="$GB" --bootloader-id=systemLinux $NVRAM
    # the fallback path too, for firmware that forgets its boot entries
    grub-install --target=x86_64-efi --efi-directory="$M/boot" --boot-directory="$GB" --removable
elif [ "$FW" = uefi ]; then
    # dual-boot: our own entry in the existing ESP, never the shared fallback path
    grub-install --target=x86_64-efi --efi-directory="$M/boot/efi" --boot-directory="$GB" --bootloader-id=systemLinux
else
    BIOSDISK=/dev/$(lsblk -no PKNAME "$ROOTPART" | head -1)
    grub-install --target=i386-pc --boot-directory="$GB" "$BIOSDISK"
fi
systemlinux-grubcfg "$M"

echo
echo "systemLinux $VER is installed. Remove the installation medium and reboot."
