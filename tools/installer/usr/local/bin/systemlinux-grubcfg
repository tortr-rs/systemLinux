#!/bin/sh
# Write GRUB's menu for an installed systemLinux: one entry per kernel in /boot/systemlinux (vmlinuz, or
# vmlinuz-VERSION from the linux port, each with its initrd.img[-VERSION]), newest first, plus a debug entry.
# Everything is found from what is mounted: the filesystem holding /boot (a separate /boot or EFI partition, or the
# root filesystem itself), the root filesystem, and whether root is inside LUKS (/dev/mapper/NAME).
# Run it again after adding or removing a kernel.
# usage: systemlinux-grubcfg [ROOTDIR]   (ROOTDIR: the mounted system, default /; the installer passes /mnt)
set -eu
R=${1:-/}; R=${R%/}
K=$R/boot/systemlinux
[ -d "$K" ] || { echo "systemlinux-grubcfg: no $K" >&2; exit 1; }
src() { findmnt -no SOURCE --mountpoint "$1" | sed 's/\[.*//' | head -1; }

# where GRUB finds the kernels: the /boot filesystem, and the path inside it
if [ -n "$(src "$R/boot")" ]; then BOOTDEV=$(src "$R/boot"); KPATH=/systemlinux
else BOOTDEV=$(src "${R:-/}"); KPATH=/boot/systemlinux; fi
BUUID=$(blkid -s UUID -o value "$BOOTDEV")
# what the initramfs mounts as root
RDEV=$(src "${R:-/}")
RTYPE=$(blkid -s TYPE -o value "$RDEV")
EXTRA=
case "$RDEV" in
    /dev/mapper/*)
        under=$(cryptsetup status "${RDEV#/dev/mapper/}" | awk '$1 == "device:" {print $2}')
        [ -n "$under" ] || { echo "systemlinux-grubcfg: $RDEV is not a LUKS mapping" >&2; exit 1; }
        ROOTSPEC=/dev/mapper/root
        EXTRA=" systemlinux.luks=UUID=$(blkid -s UUID -o value "$under")" ;;
    *)  ROOTSPEC=UUID=$(blkid -s UUID -o value "$RDEV") ;;
esac
[ -n "$BUUID" ] && [ -n "$ROOTSPEC" ] || { echo "systemlinux-grubcfg: cannot tell the boot or root filesystem" >&2; exit 1; }
CMD="root=$ROOTSPEC rootfstype=$RTYPE$EXTRA"

mkdir -p "$K/grub"
{
cat <<HEAD
# written by systemlinux-grubcfg; run it again instead of editing this file
set timeout=3
set default=0
set color_normal=light-gray/black
set color_highlight=black/yellow
insmod part_gpt
insmod part_msdos
insmod fat
insmod ext2
search --no-floppy --fs-uuid --set=root $BUUID
HEAD
first=1
for k in $(ls -1 "$K" | grep '^vmlinuz' | sort -rV); do
    v=${k#vmlinuz}
    [ -f "$K/initrd.img$v" ] || { echo "systemlinux-grubcfg: skipping $k: no initrd.img$v" >&2; continue; }
    label="systemLinux"; [ -n "$v" ] && label="systemLinux (kernel ${v#-})"
    cat <<ENTRY

menuentry "$label" {
    linux $KPATH/$k $CMD quiet loglevel=3
    initrd $KPATH/initrd.img$v
}
ENTRY
    if [ "$first" = 1 ]; then
        cat <<ENTRY

menuentry "$label (debug: all messages, shell before starting)" {
    linux $KPATH/$k $CMD systemlinux.debug=1
    initrd $KPATH/initrd.img$v
}
ENTRY
    fi
    first=0
done
} > "$K/grub/grub.cfg.new"
mv "$K/grub/grub.cfg.new" "$K/grub/grub.cfg"
echo "systemlinux-grubcfg: $K/grub/grub.cfg (root=$ROOTSPEC on $RDEV, kernels on $BOOTDEV)"
