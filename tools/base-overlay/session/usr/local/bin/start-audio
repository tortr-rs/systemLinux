#!/bin/sh
# systemLinux: system-wide PipeWire audio stack (run by audio.service). There is no
# desktop session manager to launch this per-session as the GNOME edition used to, so it runs
# once at boot instead, on the system PipeWire socket, available to whichever user runs audio
# programs.
mkdir -p /run/pipewire
export PIPEWIRE_RUNTIME_DIR=/run/pipewire
export XDG_RUNTIME_DIR=/run/pipewire
P=/nix/var/goget/profiles/system/current/bin
"$P/pipewire" &
i=0
while [ ! -S "$XDG_RUNTIME_DIR/pipewire-0" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
"$P/wireplumber" &
"$P/pipewire-pulse" &
wait
