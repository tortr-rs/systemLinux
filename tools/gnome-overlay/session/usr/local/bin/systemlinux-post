#!/bin/sh
# Installer job: turn the copied live system at $1 into the installed system for user $2 (autologin $3).
set -e
ROOT=$1 USERN=$2 AUTO=${3:-0}
[ -d "$ROOT/etc" ] || { echo "target root $ROOT not found" >&2; exit 1; }

# leave the live session behind: the live user, its home, its passwordless sudo and polkit rules
userdel -R "$ROOT" -r live 2>/dev/null || true
rm -rf "$ROOT/home/live"
rm -f "$ROOT/etc/sudoers.d/20-live" "$ROOT/etc/polkit-1/rules.d/49-live.rules"

# the GNOME sign-in screen: sign in automatically as this user, or ask for the password
mkdir -p "$ROOT/etc/systemL" "$ROOT/etc/gdm3" "$ROOT/var/lib/AccountsService/users"
rm -f "$ROOT/etc/systemL/autologin" "$ROOT/var/lib/AccountsService/users/live"
: > "$ROOT/etc/systemL/display-manager"
{
    echo "# generated by the systemLinux installer"
    echo "[daemon]"
    echo "WaylandEnable=true"
    echo "InitialSetupEnable=false"
    if [ "$AUTO" = 1 ]; then echo "AutomaticLoginEnable=true"; echo "AutomaticLogin=$USERN"; fi
    echo "[security]"; echo "[xdmcp]"; echo "[chooser]"; echo "[debug]"
} > "$ROOT/etc/gdm3/daemon.conf"
printf '[User]\nIcon=/usr/share/systemlinux/logo.png\nSystemAccount=false\n' > "$ROOT/var/lib/AccountsService/users/$USERN"

# every install gets its own machine identity
rm -f "$ROOT/etc/machine-id" "$ROOT/var/lib/dbus/machine-id"
rm -f "$ROOT"/etc/ssh/ssh_host_*
