#!/usr/bin/env -S gjs -m
// systemLinux installer: a GNOME (GTK4 + libadwaita) wizard around systemlinux-install-run.
//   systemlinux-installer            normal use (needs sudo, which the live user has)
//   systemlinux-installer --demo     fake disks and a fake install; nothing is touched
//   systemlinux-installer --demo --shot DIR   also save a PNG of every page into DIR, then quit
import GLib from 'gi://GLib';
import Gio from 'gi://Gio';
import Gtk from 'gi://Gtk?version=4.0';
import Gdk from 'gi://Gdk?version=4.0';
import Adw from 'gi://Adw?version=1';
import Graphene from 'gi://Graphene';
import System from 'system';

const HERE = GLib.path_get_dirname(GLib.filename_from_uri(import.meta.url)[0]);
const LOGO = ['/usr/share/systemlinux/logo.png', GLib.build_filenamev([HERE, '..', '..', 'share', 'systemlinux', 'logo.png'])]
    .find(p => GLib.file_test(p, GLib.FileTest.EXISTS)) ?? '/usr/share/systemlinux/logo.png';
const BACKEND = '/usr/local/bin/systemlinux-install-run';

const args = System.programArgs;
const DEMO = args.includes('--demo');
const SHOT_DIR = args.includes('--shot') ? args[args.indexOf('--shot') + 1] : null;

const KEYBOARDS = [
    ['English (US)', 'us'], ['English (UK)', 'uk'], ['German', 'de'], ['French', 'fr'], ['Spanish', 'es'],
    ['Italian', 'it'], ['Portuguese (Portugal)', 'pt-latin1'], ['Portuguese (Brazil)', 'br-abnt2'],
    ['Russian', 'ru'], ['Dvorak', 'dvorak'], ['Colemak', 'colemak'],
];

const state = {
    disk: '', host: 'systemlinux', full: '', user: '', pass: '', tz: 'UTC', keymap: 'us', autologin: false,
};

// ---------------------------------------------------------------- helpers
function readFile(path) {
    try {
        const [ok, bytes] = GLib.file_get_contents(path);
        return ok ? new TextDecoder().decode(bytes) : '';
    } catch (e) {
        return '';
    }
}

function humanSize(bytes) {
    if (bytes >= 1e12) return `${(bytes / 1e12).toFixed(1)} TB`;
    return `${Math.round(bytes / 1e9)} GB`;
}

function listDisks() {
    if (DEMO)
        return [
            {path: '/dev/nvme0n1', size: 512e9, model: 'Samsung SSD 970 EVO', busy: ''},
            {path: '/dev/sda', size: 240e9, model: 'Kingston A400', busy: ''},
            {path: '/dev/sdb', size: 32e9, model: 'USB Flash Drive (the live medium)', busy: 'In use'},
        ];
    const mounts = readFile('/proc/self/mounts').split('\n');
    const skip = /^(loop|ram|sr|zram|fd|dm-|md|nbd)/;
    const disks = [];
    const dir = Gio.File.new_for_path('/sys/block');
    const en = dir.enumerate_children('standard::name', Gio.FileQueryInfoFlags.NONE, null);
    let info;
    while ((info = en.next_file(null)) !== null) {
        const n = info.get_name();
        if (skip.test(n)) continue;
        const sectors = parseInt(readFile(`/sys/block/${n}/size`).trim() || '0');
        if (!sectors) continue;
        const model = readFile(`/sys/block/${n}/device/model`).trim().replace(/\s+/g, ' ') || 'Disk';
        const used = mounts.find(l => l.startsWith(`/dev/${n}`));
        disks.push({path: `/dev/${n}`, size: sectors * 512, model, busy: used ? 'In use' : ''});
    }
    return disks.sort((a, b) => a.path.localeCompare(b.path));
}

function listTimezones() {
    let text = readFile('/usr/share/zoneinfo/zone1970.tab') || readFile('/usr/share/zoneinfo/zone.tab');
    const zones = text.split('\n').filter(l => l && !l.startsWith('#')).map(l => l.split('\t')[2]).filter(Boolean);
    zones.sort();
    return ['UTC', ...zones];
}

function bootMode() {
    return GLib.file_test('/sys/firmware/efi', GLib.FileTest.IS_DIR) ? 'UEFI' : 'BIOS (legacy)';
}

function makePage(title, child, tag) {
    const toolbar = new Adw.ToolbarView();
    toolbar.add_top_bar(new Adw.HeaderBar());
    toolbar.set_content(child);
    return new Adw.NavigationPage({title, child: toolbar, tag});
}

// A scrolled, centred column with a heading, used by every step.
function column(heading, sub) {
    const box = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 18, margin_top: 24, margin_bottom: 24,
        margin_start: 12, margin_end: 12});
    box.append(new Gtk.Label({label: heading, css_classes: ['title-1'], xalign: 0, wrap: true}));
    if (sub) box.append(new Gtk.Label({label: sub, css_classes: ['dim-label'], xalign: 0, wrap: true}));
    const clamp = new Adw.Clamp({maximum_size: 560, child: box});
    const scroller = new Gtk.ScrolledWindow({hscrollbar_policy: Gtk.PolicyType.NEVER, vexpand: true, child: clamp});
    return {box, widget: scroller};
}

function primaryButton(label, destructive = false) {
    const b = new Gtk.Button({label, halign: Gtk.Align.END, margin_top: 6,
        css_classes: ['pill', destructive ? 'destructive-action' : 'suggested-action']});
    return b;
}

// ---------------------------------------------------------------- the window
class Installer {
    constructor(app) {
        this.win = new Adw.ApplicationWindow({application: app, title: 'Install systemLinux',
            default_width: 720, default_height: 640});
        this.nav = new Adw.NavigationView();
        this.toasts = new Adw.ToastOverlay({child: this.nav});
        this.win.set_content(this.toasts);
        this.installing = false;
        this.log = [];
        this.win.connect('close-request', () => this.installing);   // no closing mid-install
        this.pages = {};
        this.nav.push(this.welcomePage());
    }

    // ---- 1. welcome
    welcomePage() {
        const status = new Adw.StatusPage({
            title: 'Welcome to systemLinux',
            description: 'Install systemLinux on this computer, or keep trying it out.\nThe installer takes about ten minutes.',
            paintable: Gdk.Texture.new_from_filename(LOGO),
        });
        const install = new Gtk.Button({label: 'Install systemLinux', halign: Gtk.Align.CENTER,
            css_classes: ['pill', 'suggested-action']});
        const later = new Gtk.Button({label: 'Continue Trying It', halign: Gtk.Align.CENTER, css_classes: ['pill']});
        const buttons = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 10, halign: Gtk.Align.CENTER});
        buttons.append(install);
        buttons.append(later);
        status.set_child(buttons);
        install.connect('clicked', () => this.nav.push(this.diskPage()));
        later.connect('clicked', () => this.win.close());
        const p = makePage('Welcome', status, 'welcome');
        this.pages.welcome = p;
        return p;
    }

    // ---- 2. disk
    diskPage() {
        const {box, widget} = column('Choose a disk',
            'systemLinux will be installed on the whole disk you pick. Everything on it will be erased.');
        const group = new Adw.PreferencesGroup();
        let first = null;
        const next = primaryButton('Next');
        next.sensitive = false;
        const disks = listDisks();
        if (disks.length === 0) {
            group.add(new Adw.ActionRow({title: 'No disk found', subtitle: 'Connect a disk and restart the installer.'}));
        }
        for (const d of disks) {
            const row = new Adw.ActionRow({title: d.path,
                subtitle: `${humanSize(d.size)} · ${d.model}${d.busy ? ' · ' + d.busy : ''}`, sensitive: !d.busy});
            const check = new Gtk.CheckButton({valign: Gtk.Align.CENTER});
            if (first) check.set_group(first); else first = check;
            row.add_prefix(check);
            row.set_activatable_widget(check);
            check.connect('toggled', () => {
                if (check.active) { state.disk = d.path; state.diskSize = d.size; next.sensitive = true; }
            });
            group.add(row);
        }
        box.append(group);
        box.append(next);
        next.connect('clicked', () => this.nav.push(this.accountPage()));
        const p = makePage('Disk', widget, 'disk');
        this.pages.disk = p;
        return p;
    }

    // ---- 3. account
    accountPage() {
        const {box, widget} = column('Who are you?', 'This account will manage the computer.');
        const group = new Adw.PreferencesGroup();
        const full = new Adw.EntryRow({title: 'Your name'});
        const user = new Adw.EntryRow({title: 'Username'});
        const host = new Adw.EntryRow({title: 'Computer name', text: state.host});
        const pass = new Adw.PasswordEntryRow({title: 'Password'});
        const pass2 = new Adw.PasswordEntryRow({title: 'Confirm password'});
        for (const r of [full, user, host, pass, pass2]) group.add(r);
        const auto = new Adw.SwitchRow({title: 'Log in automatically', subtitle: 'Skip the login prompt on this computer.'});
        const group2 = new Adw.PreferencesGroup();
        group2.add(auto);
        const error = new Gtk.Label({xalign: 0, css_classes: ['error'], wrap: true});
        const next = primaryButton('Next');
        next.sensitive = false;

        let userEdited = false;
        full.connect('changed', () => {
            if (!userEdited) {   // suggest a username from the name
                const suggestion = full.text.toLowerCase().split(/\s+/)[0].replace(/[^a-z0-9_-]/g, '');
                user.set_text(suggestion);
                userEdited = false;
            }
        });
        user.connect('changed', () => { if (user.has_focus || user.get_focus_child()) userEdited = true; });

        const validate = () => {
            let msg = '';
            if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(user.text) || ['root', 'live'].includes(user.text))
                msg = user.text ? 'The username may use lowercase letters, digits, "_" and "-", and cannot be "root" or "live".' : '';
            else if (!/^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$/.test(host.text))
                msg = 'The computer name may only use letters, digits and "-".';
            else if (pass2.text && pass.text !== pass2.text)
                msg = 'The two passwords do not match.';
            error.label = msg;
            next.sensitive = !msg && user.text.length > 0 && host.text.length > 0 && pass.text.length > 0 &&
                pass.text === pass2.text && !/[\r\n]/.test(pass.text);
        };
        for (const r of [user, host, pass, pass2]) r.connect('changed', validate);
        box.append(group);
        box.append(group2);
        box.append(error);
        box.append(next);
        next.connect('clicked', () => {
            state.full = full.text; state.user = user.text; state.host = host.text; state.pass = pass.text;
            state.autologin = auto.active;
            this.nav.push(this.regionPage());
        });
        const p = makePage('Account', widget, 'account');
        this.pages.account = p;
        this.accountRows = {full, user, host, pass, pass2, auto};
        return p;
    }

    // ---- 4. region
    regionPage() {
        const {box, widget} = column('Time zone and keyboard', 'You can change these later in Settings.');
        const group = new Adw.PreferencesGroup();
        const zones = listTimezones();
        const tzRow = new Adw.ComboRow({title: 'Time zone', model: Gtk.StringList.new(zones), enable_search: true});
        tzRow.selected = Math.max(0, zones.indexOf(state.tz));
        const kbRow = new Adw.ComboRow({title: 'Keyboard layout', model: Gtk.StringList.new(KEYBOARDS.map(k => k[0]))});
        group.add(tzRow);
        group.add(kbRow);
        const next = primaryButton('Next');
        box.append(group);
        box.append(next);
        next.connect('clicked', () => {
            state.tz = zones[tzRow.selected];
            state.keymap = KEYBOARDS[kbRow.selected][1];
            state.kbName = KEYBOARDS[kbRow.selected][0];
            this.nav.push(this.summaryPage());
        });
        const p = makePage('Region', widget, 'region');
        this.pages.region = p;
        return p;
    }

    // ---- 5. summary
    summaryPage() {
        const {box, widget} = column('Ready to install', 'Check the details below.');
        const banner = new Adw.Banner({title: `Everything on ${state.disk} will be erased.`, revealed: true});
        const group = new Adw.PreferencesGroup();
        const rows = [
            ['Disk', `${state.disk} (${humanSize(state.diskSize || 0)})`],
            ['Boot mode', bootMode()],
            ['Computer name', state.host],
            ['User', state.full ? `${state.full} (${state.user})` : state.user],
            ['Time zone', state.tz],
            ['Keyboard', state.kbName || state.keymap],
            ['Login', state.autologin ? 'Automatic' : 'Ask for a password'],
        ];
        for (const [t, v] of rows) {
            const r = new Adw.ActionRow({title: t, subtitle: v});
            r.add_css_class('property');
            group.add(r);
        }
        const go = primaryButton('Erase Disk and Install', true);
        box.append(banner);
        box.append(group);
        box.append(go);
        go.connect('clicked', () => this.startInstall());
        const p = makePage('Summary', widget, 'summary');
        this.pages.summary = p;
        return p;
    }

    // ---- 6. progress
    progressPage() {
        const {box, widget} = column('Installing systemLinux', 'This takes a few minutes. Please do not turn the computer off.');
        this.bar = new Gtk.ProgressBar({show_text: true});
        this.stepLabel = new Gtk.Label({label: 'Starting…', xalign: 0, css_classes: ['heading']});
        this.steps = new Gtk.ListBox({selection_mode: Gtk.SelectionMode.NONE, css_classes: ['boxed-list']});
        box.append(this.bar);
        box.append(this.stepLabel);
        box.append(this.steps);
        const toolbar = new Adw.ToolbarView();
        toolbar.add_top_bar(new Adw.HeaderBar({show_back_button: false, show_end_title_buttons: false}));
        toolbar.set_content(widget);
        const p = new Adw.NavigationPage({title: 'Installing', child: toolbar, tag: 'progress', can_pop: false});
        this.pages.progress = p;
        return p;
    }

    setStep(pct, message) {
        this.bar.fraction = Math.min(1, pct / 100);
        this.bar.text = `${Math.round(pct)}%`;
        this.stepLabel.label = message;
        if (this.activeRow) {                     // the previous step is done
            this.activeRow.remove(this.activeRow.spinner);
            this.activeRow.add_prefix(new Gtk.Image({icon_name: 'object-select-symbolic', css_classes: ['success']}));
        }
        const row = new Adw.ActionRow({title: message});
        row.spinner = new Gtk.Spinner({spinning: true});
        row.add_prefix(row.spinner);
        this.steps.append(row);
        this.activeRow = row;
    }

    // ---- 7. result pages
    donePage() {
        const status = new Adw.StatusPage({
            title: 'systemLinux is installed',
            description: 'Remove the installation media, then restart to start using it.',
            icon_name: 'object-select-symbolic',
        });
        const restart = new Gtk.Button({label: 'Restart Now', halign: Gtk.Align.CENTER,
            css_classes: ['pill', 'suggested-action']});
        const stay = new Gtk.Button({label: 'Keep Trying It', halign: Gtk.Align.CENTER, css_classes: ['pill']});
        const buttons = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 10, halign: Gtk.Align.CENTER});
        buttons.append(restart);
        buttons.append(stay);
        status.set_child(buttons);
        restart.connect('clicked', () => {
            if (!DEMO) GLib.spawn_command_line_async('sudo -n reboot');
            else this.win.close();
        });
        stay.connect('clicked', () => this.win.close());
        const toolbar = new Adw.ToolbarView();
        toolbar.add_top_bar(new Adw.HeaderBar({show_back_button: false}));
        toolbar.set_content(status);
        return new Adw.NavigationPage({title: 'Done', child: toolbar, tag: 'done', can_pop: false});
    }

    failurePage(reason) {
        const status = new Adw.StatusPage({
            title: 'The installation failed',
            description: `${reason}\nThe live system was not changed, and you can try again.`,
            icon_name: 'dialog-error-symbolic',
        });
        const details = new Gtk.Button({label: 'Show Details', halign: Gtk.Align.CENTER, css_classes: ['pill']});
        const close = new Gtk.Button({label: 'Close', halign: Gtk.Align.CENTER, css_classes: ['pill']});
        const buttons = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 10, halign: Gtk.Align.CENTER});
        buttons.append(details);
        buttons.append(close);
        status.set_child(buttons);
        details.connect('clicked', () => this.showLog());
        close.connect('clicked', () => this.win.close());
        const toolbar = new Adw.ToolbarView();
        toolbar.add_top_bar(new Adw.HeaderBar({show_back_button: false}));
        toolbar.set_content(status);
        return new Adw.NavigationPage({title: 'Failed', child: toolbar, tag: 'failed', can_pop: false});
    }

    showLog() {
        const view = new Gtk.TextView({editable: false, monospace: true, left_margin: 12, right_margin: 12,
            top_margin: 12, bottom_margin: 12});
        view.buffer.text = this.log.slice(-400).join('\n');
        const scroller = new Gtk.ScrolledWindow({child: view, vexpand: true});
        const toolbar = new Adw.ToolbarView();
        toolbar.add_top_bar(new Adw.HeaderBar());
        toolbar.set_content(scroller);
        const dialog = new Adw.Dialog({title: 'Installation log', child: toolbar, content_width: 640, content_height: 480});
        dialog.present(this.win);
    }

    // ---- running the install
    startInstall() {
        this.nav.push(this.progressPage());
        this.installing = true;
        this.log = [];
        this.activeRow = null;
        this.setStep(0, 'Starting');
        if (DEMO) return this.fakeInstall();

        const argv = ['sudo', '-n', BACKEND, state.disk, state.host, state.user, state.tz, state.keymap,
            state.autologin ? '1' : '0'];
        let proc;
        try {
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE |
                Gio.SubprocessFlags.STDERR_MERGE);
        } catch (e) {
            return this.finish(false, `Could not start the installer: ${e.message}`);
        }
        // the passwords go over stdin, never on a command line
        const stdin = proc.get_stdin_pipe();
        stdin.write_all(`${state.pass}\n${state.pass}\n${state.full}\n`, null);
        stdin.close(null);
        const reader = new Gio.DataInputStream({base_stream: proc.get_stdout_pipe()});
        const readNext = () => reader.read_line_async(GLib.PRIORITY_DEFAULT, null, (src, res) => {
            let line;
            try { [line] = src.read_line_finish_utf8(res); } catch (e) { line = null; }
            if (line === null) return;
            this.log.push(line);
            const m = /^@ (\d+) (.*)$/.exec(line);
            if (m) this.setStep(parseInt(m[1]), m[2]);
            readNext();
        });
        readNext();
        proc.wait_check_async(null, (p, res) => {
            try { p.wait_check_finish(res); this.finish(true); }
            catch (e) { this.finish(false, this.lastError() || 'The installer stopped unexpectedly.'); }
        });
    }

    lastError() {
        const errs = this.log.filter(l => l.startsWith('ERROR:'));
        return errs.length ? errs[errs.length - 1].replace(/^ERROR:\s*/, '') : '';
    }

    fakeInstall() {
        const steps = [[5, 'Erasing the disk'], [12, 'Creating partitions'], [20, 'Formatting'], [30, 'Mounting'],
            [55, 'Copying system files'], [80, 'Writing settings'], [90, 'Creating your account'], [96, 'Installing the bootloader'],
            [100, 'Done']];
        let i = 0;
        GLib.timeout_add(SHOT_DIR ? 200 : 900, GLib.PRIORITY_DEFAULT, () => {
            if (i >= steps.length) { this.finish(true); return GLib.SOURCE_REMOVE; }
            this.setStep(steps[i][0], steps[i][1]);
            i++;
            return GLib.SOURCE_CONTINUE;
        });
    }

    finish(ok, reason) {
        this.installing = false;
        this.nav.push(ok ? this.donePage() : this.failurePage(reason));
    }
}

// ---------------------------------------------------------------- screenshots (demo/testing)
function snapshotWidget(widget, path) {
    // render the window content (the child of the window), which is what the user sees
    const target = widget.get_content();
    const w = target.get_width(), h = target.get_height();
    if (!w || !h) { print(`shot ${path}: widget has no size (${w}x${h})`); return; }
    const paintable = Gtk.WidgetPaintable.new(target);
    const snap = Gtk.Snapshot.new();
    paintable.snapshot(snap, w, h);
    const node = snap.to_node();
    if (!node) { print(`shot ${path}: nothing was drawn`); return; }
    const renderer = widget.get_renderer();
    const texture = renderer.render_texture(node, new Graphene.Rect().init(0, 0, w, h));
    texture.save_to_png(path);
    print(`saved ${path} (${w}x${h})`);
}

function runShots(inst) {
    GLib.mkdir_with_parents(SHOT_DIR, 0o755);
    const steps = [
        ['1-welcome', () => {}],
        ['2-disk', () => inst.nav.push(inst.diskPage())],
        ['3-account', () => { state.disk = '/dev/nvme0n1'; state.diskSize = 512e9; inst.nav.push(inst.accountPage());
            const r = inst.accountRows; r.full.set_text('Ada Lovelace'); r.user.set_text('ada'); r.pass.set_text('secret'); r.pass2.set_text('secret'); }],
        ['4-region', () => { state.full = 'Ada Lovelace'; state.user = 'ada'; state.pass = 'secret'; inst.nav.push(inst.regionPage()); }],
        ['5-summary', () => { state.kbName = 'English (US)'; inst.nav.push(inst.summaryPage()); }],
        ['6-progress', () => inst.startInstall()],
        ['7-progress-later', () => {}],
        ['8-done', () => {}],
    ];
    let i = 0;
    const tick = () => {
        if (i >= steps.length) { inst.installing = false; inst.win.get_application().quit(); return GLib.SOURCE_REMOVE; }
        const [name, action] = steps[i];
        const isProgress = name.startsWith('6') || name.startsWith('7');
        if (!isProgress || name.startsWith('6')) action();
        i++;
        const delay = name.startsWith("6") ? 1500 : name.startsWith("7") ? 1800 : 1800;
        GLib.timeout_add(delay, GLib.PRIORITY_DEFAULT, () => {
            snapshotWidget(inst.win, `${SHOT_DIR}/${name}.png`);
            GLib.idle_add(GLib.PRIORITY_DEFAULT, tick);
            return GLib.SOURCE_REMOVE;
        });
        return GLib.SOURCE_REMOVE;
    };
    GLib.idle_add(GLib.PRIORITY_DEFAULT, tick);
}

// ---------------------------------------------------------------- main
const app = new Adw.Application({application_id: 'org.systemlinux.Installer', flags: Gio.ApplicationFlags.NON_UNIQUE});
app.connect('activate', () => {
    const inst = new Installer(app);
    inst.win.present();
    if (SHOT_DIR) GLib.timeout_add(2500, GLib.PRIORITY_DEFAULT, () => { runShots(inst); return GLib.SOURCE_REMOVE; });
});
app.run([System.programInvocationName]);
