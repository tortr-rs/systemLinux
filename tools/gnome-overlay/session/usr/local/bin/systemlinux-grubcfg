#!/bin/sh
# Write GRUB's menu for an installed systemLinux: one entry per image in BOOTDIR/images/<version>/.
# usage: systemlinux-grubcfg BOOTDIR DATA_UUID
# Entry ids are the version numbers, so `grub-set-default <version>` picks the default and
# `grub-reboot <version>` boots an image once (the trial boot `goget upgrade` uses; systemL makes
# a trial permanent after the system came up).
set -e
BOOT=$1 UUID=$2
[ -d "$BOOT/images" ] && [ -n "$UUID" ] || { echo "usage: systemlinux-grubcfg BOOTDIR DATA_UUID" >&2; exit 1; }
mkdir -p "$BOOT/grub"
CFG=$BOOT/grub/grub.cfg
{
cat <<'HEAD'
set timeout=3
load_env
if [ "${next_entry}" ]; then
    set default="${next_entry}"
    set next_entry=
    save_env next_entry
else
    set default="${saved_entry}"
fi
HEAD
first=1
for v in $(ls -1 "$BOOT/images" | grep -v '\.part$' | sort -rV); do
    [ -f "$BOOT/images/$v/rootfs.squashfs" ] || continue
    label="systemLinux $v"
    [ "$first" = 1 ] && label="$label (newest)"
    cat <<ENTRY

menuentry "$label" --id "$v" {
    search --no-floppy --fs-uuid --set=root $UUID
    linux /boot/images/$v/vmlinuz systeml.image=/boot/images/$v/rootfs.squashfs systeml.data=UUID=$UUID systeml.version=$v quiet loglevel=3 console=tty0
    initrd /boot/images/$v/initrd.img
}
ENTRY
    if [ "$first" = 1 ]; then
        cat <<ENTRY

menuentry "systemLinux $v (debug: show all messages)" --id "$v-debug" {
    search --no-floppy --fs-uuid --set=root $UUID
    linux /boot/images/$v/vmlinuz systeml.image=/boot/images/$v/rootfs.squashfs systeml.data=UUID=$UUID systeml.version=$v systeml.verbose=1 console=tty0
    initrd /boot/images/$v/initrd.img
}
ENTRY
    fi
    first=0
done
} > "$CFG.new"
mv "$CFG.new" "$CFG"
