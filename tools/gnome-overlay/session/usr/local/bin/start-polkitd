#!/bin/sh
# systemL service: polkit (GNOME asks it before privileged actions).
# The polkitd user must already exist when the system D-Bus starts (its policy is keyed by user name),
# so it is created in the image; this is only a fallback.
getent passwd polkitd >/dev/null || useradd -r -M -d / -s /bin/false polkitd
mkdir -p /run/polkit-1 /var/lib/polkit-1 /etc/polkit-1/rules.d
chown polkitd:polkitd /var/lib/polkit-1 2>/dev/null
exec /usr/lib/polkit-1/polkitd --log-level=err
