#!/bin/bash
# systemLinux install backend (GNOME edition), run as root by the installer app.
# usage: systemlinux-install-run DISK HOSTNAME USERNAME TIMEZONE KEYMAP AUTOLOGIN(0|1)
# stdin: root password line, user password line, full name line.
# stdout: "@ PERCENT message" progress lines; everything else (and stderr) is log text.
set -euo pipefail
DISK=$1 HOST=$2 USERN=$3 TZ=$4 KEYMAP=$5 AUTO=${6:-0}
IFS= read -r ROOTPW
IFS= read -r USERPW
IFS= read -r FULLNAME || FULLNAME=
ROOT=/mnt/target
DUFILE=$(mktemp)

step() { echo "@ $1 $2"; }
fail() { echo "ERROR: $*"; exit 1; }
cleanup() { sync; umount -R "$ROOT" 2>/dev/null || true; rm -f "$DUFILE"; }
trap cleanup EXIT
part() { case "$DISK" in *[0-9]) echo "${DISK}p$1" ;; *) echo "${DISK}$1" ;; esac; }
wait_for() { for _ in $(seq 1 50); do [ -b "$1" ] && return 0; sleep 0.2; done; fail "partition $1 did not appear"; }

[ "$(id -u)" = 0 ] || fail "the installer backend must run as root"
[ -b "$DISK" ] || fail "$DISK is not a block device"
grep -q "^$DISK" /proc/self/mounts && fail "$DISK has mounted partitions"
[[ "$USERN" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "invalid username"
[[ "$HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || fail "invalid computer name"
[ -n "$USERPW" ] || fail "empty password"
[ -f "/usr/share/zoneinfo/$TZ" ] || TZ=UTC
EFI=0; [ -d /sys/firmware/efi ] && EFI=1

# size of the live system, measured in the background, for the copy progress bar
( du -sxb / 2>/dev/null | cut -f1 > "$DUFILE" ) &

step 3 "Erasing the disk"
wipefs -a -f "$DISK" >/dev/null 2>&1 || true
dd if=/dev/zero of="$DISK" bs=1M count=4 status=none
SZ=$(blockdev --getsz "$DISK")
[ "$SZ" -gt 16384 ] && dd if=/dev/zero of="$DISK" bs=512 seek=$((SZ - 8192)) count=8192 status=none 2>/dev/null || true

step 8 "Creating partitions"
if [ "$EFI" = 1 ]; then
    printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --wipe always --wipe-partitions always "$DISK"
    ESPDEV=$(part 1); ROOTDEV=$(part 2)
else
    printf 'label: dos\n,,L,*\n' | sfdisk --wipe always --wipe-partitions always "$DISK"
    ESPDEV=; ROOTDEV=$(part 1)
fi
blockdev --rereadpt "$DISK" || true
udevadm settle --timeout=10 || true
[ -z "$ESPDEV" ] || wait_for "$ESPDEV"
wait_for "$ROOTDEV"

step 14 "Formatting the disk"
[ -z "$ESPDEV" ] || mkfs.vfat -F32 -n EFI "$ESPDEV"
mkfs.ext4 -F -q -L systemLinux "$ROOTDEV"

step 20 "Preparing the new system"
mkdir -p "$ROOT"
mount "$ROOTDEV" "$ROOT"
if [ -n "$ESPDEV" ]; then mkdir -p "$ROOT/boot/efi"; mount "$ESPDEV" "$ROOT/boot/efi"; fi

step 22 "Copying system files"
/usr/local/bin/systemlinux-copy "$ROOT" &
COPYPID=$!
TOTAL=0
while kill -0 "$COPYPID" 2>/dev/null; do
    [ "$TOTAL" -gt 0 ] || TOTAL=$(cat "$DUFILE" 2>/dev/null || echo 0)
    if [ "$TOTAL" -gt 0 ]; then
        USED=$(df -B1 --output=used "$ROOT" | tail -n1 | tr -d ' ')
        PCT=$(( 22 + USED * 60 / TOTAL ))
        [ "$PCT" -gt 82 ] && PCT=82
        step "$PCT" "Copying system files"
    fi
    sleep 3
done
wait "$COPYPID" || fail "copying the system files failed"

step 84 "Saving your settings"
RUUID=$(blkid -s UUID -o value "$ROOTDEV")
{
    echo "# /etc/fstab - generated by the systemLinux installer"
    echo "UUID=$RUUID  /  ext4  defaults,errors=remount-ro  0  1"
    if [ -n "$ESPDEV" ]; then echo "UUID=$(blkid -s UUID -o value "$ESPDEV")  /boot/efi  vfat  umask=0077  0  2"; fi
} > "$ROOT/etc/fstab"
echo "$HOST" > "$ROOT/etc/hostname"
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$HOST" > "$ROOT/etc/hosts"
rm -f "$ROOT/etc/localtime"; ln -s "../usr/share/zoneinfo/$TZ" "$ROOT/etc/localtime"
echo "LANG=C.UTF-8" > "$ROOT/etc/locale.conf"
echo "KEYMAP=$KEYMAP" > "$ROOT/etc/vconsole.conf"
LAYOUT=$KEYMAP VARIANT=
case "$KEYMAP" in
    uk) LAYOUT=gb ;;
    dvorak) LAYOUT=us VARIANT=dvorak ;;
    colemak) LAYOUT=us VARIANT=colemak ;;
    pt-latin1) LAYOUT=pt ;;
    br-abnt2) LAYOUT=br ;;
    *-latin1|*-latin9) LAYOUT=${KEYMAP%%-*} ;;
esac
mkdir -p "$ROOT/etc/X11/xorg.conf.d"
{
    echo 'Section "InputClass"'
    echo '    Identifier "system-keyboard"'
    echo '    MatchIsKeyboard "on"'
    echo "    Option \"XkbLayout\" \"$LAYOUT\""
    [ -z "$VARIANT" ] || echo "    Option \"XkbVariant\" \"$VARIANT\""
    echo 'EndSection'
} > "$ROOT/etc/X11/xorg.conf.d/00-keyboard.conf"

step 88 "Creating your account"
printf '%s\n%s\n' "$USERPW" "$USERPW" | goget provision --user "$USERN" "$ROOT"
echo "root:$ROOTPW" | chpasswd -R "$ROOT"
[ -z "$FULLNAME" ] || usermod -R "$ROOT" -c "$FULLNAME" "$USERN"
groups=
for g in users audio video input plugdev; do grep -q "^$g:" "$ROOT/etc/group" && groups="$groups,$g"; done
[ -z "$groups" ] || usermod -R "$ROOT" -aG "${groups#,}" "$USERN"

step 93 "Finishing the installed system"
/usr/local/bin/systemlinux-post "$ROOT" "$USERN" "$AUTO"

step 96 "Installing the bootloader"
/usr/local/bin/systemlinux-bootloader "$ROOT"

step 100 "Done"
