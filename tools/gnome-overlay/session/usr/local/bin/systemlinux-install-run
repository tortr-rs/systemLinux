#!/bin/bash
# systemLinux install backend, run as root by the installer app.
# usage: systemlinux-install-run DISK HOSTNAME USERNAME TIMEZONE KEYMAP AUTOLOGIN(0|1)
# stdin: root password line, user password line, full name line.
# stdout: "@ PERCENT message" progress lines; everything else (and stderr) is log text.
#
# Layout it creates: [EFI system partition 512M] + one ext4 "data" partition holding
#   /boot/images/<version>/{vmlinuz,initrd.img,rootfs.squashfs}   the system images (updated by `goget upgrade`)
#   /boot/grub                                                      GRUB's menu and environment
#   /persist/{upper,work}                                           the writable layer over the read-only image
# The system boots the squashfs with that persistent overlay, exactly like the live ISO but persistent.
set -euo pipefail
DISK=$1 HOST=$2 USERN=$3 TZ=$4 KEYMAP=$5 AUTO=${6:-0}
IFS= read -r ROOTPW
IFS= read -r USERPW
IFS= read -r FULLNAME || FULLNAME=
DATA=/mnt/target-data
SQ=/mnt/target-sq
ROOT=/mnt/target-root
MEDIUM=/live-medium

step() { echo "@ $1 $2"; }
fail() { echo "ERROR: $*"; exit 1; }
cleanup() {
    sync
    for m in "$ROOT" "$SQ" "$DATA/boot/efi" "$DATA"; do umount "$m" 2>/dev/null || true; done
}
trap cleanup EXIT
part() { case "$DISK" in *[0-9]) echo "${DISK}p$1" ;; *) echo "${DISK}$1" ;; esac; }
wait_for() { for _ in $(seq 1 50); do [ -b "$1" ] && return 0; sleep 0.2; done; fail "partition $1 did not appear"; }

[ "$(id -u)" = 0 ] || fail "the installer backend must run as root"
[ -b "$DISK" ] || fail "$DISK is not a block device"
grep -q "^$DISK" /proc/self/mounts && fail "$DISK has mounted partitions"
[[ "$USERN" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "invalid username"
[[ "$HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || fail "invalid computer name"
[ -n "$USERPW" ] || fail "empty password"
[ -f "/usr/share/zoneinfo/$TZ" ] || TZ=UTC
for f in vmlinuz initrd.img rootfs.squashfs; do
    [ -f "$MEDIUM/live/$f" ] || fail "the live medium is not available ($MEDIUM/live/$f missing); boot the installer from the ISO"
done
VER=$(cat /usr/share/systemlinux/image-version 2>/dev/null || true)
[ -n "$VER" ] || fail "this image has no version (/usr/share/systemlinux/image-version)"
EFI=0; [ -d /sys/firmware/efi ] && EFI=1

step 3 "Erasing the disk"
wipefs -a -f "$DISK" >/dev/null 2>&1 || true
dd if=/dev/zero of="$DISK" bs=1M count=4 status=none
SZ=$(blockdev --getsz "$DISK")
[ "$SZ" -gt 16384 ] && dd if=/dev/zero of="$DISK" bs=512 seek=$((SZ - 8192)) count=8192 status=none 2>/dev/null || true

step 8 "Creating partitions"
if [ "$EFI" = 1 ]; then
    printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --wipe always --wipe-partitions always "$DISK"
    ESPDEV=$(part 1); DATADEV=$(part 2)
else
    printf 'label: dos\n,,L,*\n' | sfdisk --wipe always --wipe-partitions always "$DISK"
    ESPDEV=; DATADEV=$(part 1)
fi
blockdev --rereadpt "$DISK" || true
udevadm settle --timeout=10 || true
[ -z "$ESPDEV" ] || wait_for "$ESPDEV"
wait_for "$DATADEV"

step 14 "Formatting the disk"
[ -z "$ESPDEV" ] || mkfs.vfat -F32 -n EFI "$ESPDEV"
mkfs.ext4 -F -q -L systemLinux "$DATADEV"
DUUID=$(blkid -s UUID -o value "$DATADEV")

step 18 "Preparing the new system"
mkdir -p "$DATA" "$SQ" "$ROOT"
mount "$DATADEV" "$DATA"
mkdir -p "$DATA/boot/images/$VER.part" "$DATA/persist/upper" "$DATA/persist/work" "$DATA/boot/efi"
if [ -n "$ESPDEV" ]; then mount "$ESPDEV" "$DATA/boot/efi"; fi

step 20 "Copying the system image"
TOTAL=0; for f in vmlinuz initrd.img rootfs.squashfs; do TOTAL=$((TOTAL + $(stat -c %s "$MEDIUM/live/$f"))); done
for f in vmlinuz initrd.img rootfs.squashfs; do
    cp "$MEDIUM/live/$f" "$DATA/boot/images/$VER.part/$f" &
    CPID=$!
    while kill -0 "$CPID" 2>/dev/null; do
        DONE=$(du -sb "$DATA/boot/images/$VER.part" | cut -f1)
        step $(( 20 + DONE * 60 / TOTAL )) "Copying the system image"
        sleep 2
    done
    wait "$CPID" || fail "copying $f failed"
done
sync
mv "$DATA/boot/images/$VER.part" "$DATA/boot/images/$VER"

step 82 "Saving your settings"
mount -t squashfs -o loop,ro "$DATA/boot/images/$VER/rootfs.squashfs" "$SQ"
mount -t overlay overlay -o "lowerdir=$SQ,upperdir=$DATA/persist/upper,workdir=$DATA/persist/work" "$ROOT"
{
    echo "# /etc/fstab - generated by the systemLinux installer"
    echo "# the boot files live on the data partition (mounted at /data by the initramfs)"
    echo "/data/boot  /boot  none  bind  0 0"
    if [ -n "$ESPDEV" ]; then echo "UUID=$(blkid -s UUID -o value "$ESPDEV")  /boot/efi  vfat  umask=0077  0  2"; fi
} > "$ROOT/etc/fstab"
echo "$HOST" > "$ROOT/etc/hostname"
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$HOST" > "$ROOT/etc/hosts"
rm -f "$ROOT/etc/localtime"; ln -s "../usr/share/zoneinfo/$TZ" "$ROOT/etc/localtime"
echo "LANG=C.UTF-8" > "$ROOT/etc/locale.conf"
echo "KEYMAP=$KEYMAP" > "$ROOT/etc/vconsole.conf"
LAYOUT=$KEYMAP VARIANT=
case "$KEYMAP" in
    uk) LAYOUT=gb ;;
    dvorak) LAYOUT=us VARIANT=dvorak ;;
    colemak) LAYOUT=us VARIANT=colemak ;;
    pt-latin1) LAYOUT=pt ;;
    br-abnt2) LAYOUT=br ;;
    *-latin1|*-latin9) LAYOUT=${KEYMAP%%-*} ;;
esac
mkdir -p "$ROOT/etc/X11/xorg.conf.d"
{
    echo 'Section "InputClass"'
    echo '    Identifier "system-keyboard"'
    echo '    MatchIsKeyboard "on"'
    echo "    Option \"XkbLayout\" \"$LAYOUT\""
    [ -z "$VARIANT" ] || echo "    Option \"XkbVariant\" \"$VARIANT\""
    echo 'EndSection'
} > "$ROOT/etc/X11/xorg.conf.d/00-keyboard.conf"

step 88 "Creating your account"
printf '%s\n%s\n' "$USERPW" "$USERPW" | goget provision --user "$USERN" "$ROOT"
echo "root:$ROOTPW" | chpasswd -R "$ROOT"
[ -z "$FULLNAME" ] || usermod -R "$ROOT" -c "$FULLNAME" "$USERN"
groups=
for g in users audio video input plugdev; do grep -q "^$g:" "$ROOT/etc/group" && groups="$groups,$g"; done
[ -z "$groups" ] || usermod -R "$ROOT" -aG "${groups#,}" "$USERN"

step 92 "Finishing the installed system"
/usr/local/bin/systemlinux-post "$ROOT" "$USERN" "$AUTO"
umount "$ROOT"; umount "$SQ"

step 95 "Installing the bootloader"
if [ "$EFI" = 1 ]; then
    grub-install --target=x86_64-efi --efi-directory="$DATA/boot/efi" --boot-directory="$DATA/boot" --removable
    if [ -d /sys/firmware/efi/efivars ]; then
        PARTNUM=$(cat "/sys/class/block/$(basename "$ESPDEV")/partition")
        efibootmgr -c -d "$DISK" -p "$PARTNUM" -L systemLinux -l '\EFI\BOOT\BOOTX64.EFI' || true
    fi
else
    grub-install --target=i386-pc --boot-directory="$DATA/boot" "$DISK"
fi
/usr/local/bin/systemlinux-grubcfg "$DATA/boot" "$DUUID"
grub-editenv "$DATA/boot/grub/grubenv" create
grub-set-default --boot-directory="$DATA/boot" "$VER"

step 100 "Done"
