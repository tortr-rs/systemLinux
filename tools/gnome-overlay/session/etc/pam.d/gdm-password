# systemLinux: password sign-in from the GNOME sign-in screen and the lock screen
auth     include  system-auth
account  include  system-auth
password include  system-auth
session  include  system-auth
session  required pam_env.so conffile=/etc/security/pam_env.conf
-session optional /usr/lib/x86_64-linux-gnu/security/pam_elogind.so
