[org.gnome.shell]
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.Settings.desktop', 'org.systemlinux.Installer.desktop']
welcome-dialog-last-shown-version='999'

[org.gnome.desktop.screensaver]
lock-enabled=true
idle-activation-enabled=true

[org.gnome.desktop.session]
idle-delay=uint32 300

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/systemlinux/default.png'
picture-uri-dark='file:///usr/share/backgrounds/systemlinux/default.png'
picture-options='zoom'
primary-color='#54487a'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='green'
