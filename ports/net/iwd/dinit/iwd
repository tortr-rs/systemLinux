# iwd Wi-Fi daemon (iwctl). Do not run it next to NetworkManager's own Wi-Fi handling.
# Enable with: dinitctl enable iwd
type = process
command = /usr/libexec/iwd
depends-on = dbus
waits-for = udev-trigger
smooth-recovery = true
# output goes to a log file, not over the console and the login prompt
logfile = /var/log/iwd.log
