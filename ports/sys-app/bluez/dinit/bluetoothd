# Bluetooth daemon (bluetoothctl). Enable with: dinitctl enable bluetoothd
type = process
command = /usr/libexec/bluetooth/bluetoothd -n
depends-on = dbus
waits-for = udev-trigger
smooth-recovery = true
# output goes to a log file, not over the console and the login prompt
logfile = /var/log/bluetoothd.log
